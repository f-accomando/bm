-- the call of blocked without its work: the same ten parameters, and the result 0 (what the machine costs to enter and leave)
function noop(x: f64, y: f64, solid: i32[], ready: i32[], colx: f64[], coly: f64[], colrx: f64[], colry: f64[],
              coloff: i32[], ccount: i32[]): i32
  return 0
end
